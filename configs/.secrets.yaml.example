# ========================================================
# configs/.secrets.yaml.example
# 立体空间智能体系统 · 敏感私有凭证隔离模板 (复制并重命名为 .secrets.yaml 生效)
# ⚠️ 此文件已在 .gitignore 中自动排除，杜绝代码共享或备份时泄露私密卡密
# ========================================================

gateway:
  # 商业卡密 (优先级: 环境变量 LITIKJ_LICENSE_KEY > 本文件 > framework.yaml)
  license_key: "LITI-AGENT-XXXX-XXXX-XXXX"

  # 自备私有大模型 Key (优先级: 环境变量 DEEPSEEK_API_KEY / OPENAI_API_KEY > 本文件 > framework.yaml)
  custom:
    api_key: "sk-your-private-api-key-here"
